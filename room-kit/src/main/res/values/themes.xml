<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Roomkit" parent="Theme.MaterialComponents">
        <!-- Primary brand color. -->
        <item name="android:dividerHeight">8dp</item>

        <!-- Retrowave Primary Colors -->
        <item name="colorPrimary">#00CCFF</item>
        <item name="colorPrimaryVariant">#0099CC</item>

        <!-- Retrowave Secondary Colors -->
        <item name="colorSecondary">#FF3399</item>
        <item name="colorSecondaryVariant">#CC1A80</item>

        <!-- Retrowave Surface Colors -->
        <item name="colorSurface">#0D0D26</item>
        <item name="android:colorBackground">#000000</item>

        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorOnPrimarySurface">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="fontFamily">@font/funnel_display_regular</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.HmsHomeApp" parent="Theme.MaterialComponents">
        <!-- Retrowave Colors -->
        <item name="colorPrimary">#00CCFF</item>
        <item name="colorSurface">#1A1A33</item>
        <item name="colorSecondaryVariant">#1A1A33</item>
        <!-- Overflow Menu -->
        <item name="android:itemBackground">#1A1A33</item>

        <!-- Default Background Color -->
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#0D0D26</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorOnPrimarySurface">#FFFFFF</item>

    </style>

    <style name="Theme.HmsHomeApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Roomkit.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
    </style>
    <style name="AutoCompleteTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="hintEnabled">true</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <style name="MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="fontFamily">@font/funnel_display_medium</item>
    </style>

    <style name="MaterialTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="fontFamily">@font/funnel_display_medium</item>
    </style>

    <style name="MaterialTextViewHeading" parent="Widget.MaterialComponents.TextView">
        <item name="fontFamily">@font/funnel_display_medium</item>
    </style>

    <style name="MaterialSwitch" parent="Widget.AppCompat.CompoundButton.Switch"></style>

    <style name="MaterialImageButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:inset">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/shape_round_dialog</item>
    </style>

    <style name="RoleChangeAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="fontFamily">@font/funnel_display_medium</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="fontFamily">@font/funnel_display_medium</item>
    </style>

    <style name="SpinnerTheme" parent="android:Widget.Spinner">
        <item name="android:background">@drawable/stroked_round_drawable</item>
    </style>

    <style name="HmsHeadings" parent="MaterialTextViewHeading">
        <item name="android:fontFamily">@font/funnel_display_semibold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="HmsPollCardText" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="HmsSubHeadings" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="QuestionNumberText" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="android:textColor">#CCE6FF80</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="poll_display_title">
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="poll_display_question_numbering">
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">#CCE6FF80</item>
    </style>

    <style name="poll_display_answer_item">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="polls_question_asking_options">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">#CCE6FF</item>
    </style>

    <style name="RoundedTabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabIndicator">@null</item>
    </style>
    <style name="RoundedTabsTextStyle" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="fontFamily">@font/funnel_display_semibold</item>
        <item name="android:textSize">14dp</item>
    </style>

    <style name="RoundedTabDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/RoundedBottomSheetStyle</item>
    </style>

    <style name="RoundedBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
